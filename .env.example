# Copie ce fichier en ".env" et renseigne tes propres clés.
# Ne commit JAMAIS le fichier ".env" (il est déjà dans .gitignore).

# Clé API Groq (gratuite, sans carte bancaire) — https://console.groq.com/keys
GROQ_API_KEY=

# Clé API SlidesGPT — https://slidesgpt.com/settings/api-keys
SLIDESGPT_API_KEY=

# Envoi d'email récapitulatif (optionnel — omets ces 3 lignes pour désactiver)
# EMAIL_SENDER : ton adresse Gmail d'envoi
# EMAIL_APP_PASSWORD : un "mot de passe d'application" Gmail, PAS ton mot de passe normal
#   → https://myaccount.google.com/apppasswords (nécessite la validation en 2 étapes activée)
# EMAIL_RECIPIENT : l'adresse qui recevra le récapitulatif (peut être la même que EMAIL_SENDER)
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
